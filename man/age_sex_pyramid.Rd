library(plotly)
ui <- fluidPage(
  plotOutput('static_pyramid'),
  plotlyOutput('dynamic_pyramid')
)
server <- function(input, output, session) {
  output$static_pyramid <- renderPlot(static_pyramid)
  output$dynamic_pyramid <- renderPlotly(dynamic_pyramid)
}
shinyApp(ui, server)



